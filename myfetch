      ${or}=================     =====${r}
        ${or}=======================${r}
          ${or}===================${r}
              ${or}===========${r}


EOF
        ;;
    linuxmint)
        sg="$SGREEN"
        r="$RESET"
        IFS= read -r -d '' ascii <<EOF

            ${sg}===============${r}
