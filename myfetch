#!/usr/bin/env bash

GREY_MODE=false
COLOR_HEX=""
for arg in "$@"; do
    case "$arg" in
        --grey)      GREY_MODE=true ;;
        --color:*)   COLOR_HEX="${arg#--color:}" ;;
    esac
done

_hex_to_ansi() {
    local hex="${1#'#'}"
    local r=$((16#${hex:0:2}))
    local g=$((16#${hex:2:2}))
    local b=$((16#${hex:4:2}))
    printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
}
_hex_to_ansi_bold() {
    local hex="${1#'#'}"
    local r=$((16#${hex:0:2}))
    local g=$((16#${hex:2:2}))
    local b=$((16#${hex:4:2}))
    printf '\033[1;38;2;%d;%d;%dm' "$r" "$g" "$b"
}

# colors
_INFO_COLOR=""
if $GREY_MODE; then
    SYELLOW=""
    SBLACK=""
    SBRIGHTBLUE=""
    PURPLE=""
    BLUE=""
    SBLUE=""
    TEAL=""
    TEAL_DIM=""
    WHITE=""
    ORANGE=""
    SORANGE=""
    GREEN=""
    SGREEN=""
    RESET=""
elif [ -n "$COLOR_HEX" ]; then
    _C=$(_hex_to_ansi "$COLOR_HEX")
    _CB=$(_hex_to_ansi_bold "$COLOR_HEX")
    RESET=$'\033[0m'
    _INFO_COLOR="$_C"
    # all palette vars → same single color
    SYELLOW="$_C"
    SBLACK="$_C"
    SBRIGHTBLUE="$_C"
    PURPLE="$_C"
    BLUE="$_C"
    SBLUE="$_C"
    TEAL="$_C"
    TEAL_DIM="$_C"
    WHITE="$_C"
    ORANGE="$_C"
    SORANGE="$_C"
    GREEN="$_C"
    SGREEN="$_C"
    _CUSTOM_LABEL_COLOR="$_CB"
else
    SYELLOW=$'\033[33m'
    SBLACK=$'\033[39m'
    SBRIGHTBLUE=$'\033[38;5;153m'
    PURPLE=$'\033[35m'
    BLUE=$'\033[1;34m'
    SBLUE=$'\033[34m'
    TEAL=$'\033[38;5;43m'
    TEAL_DIM=$'\033[36m'
    WHITE=$'\033[1;37m'
    ORANGE=$'\033[1;38;5;208m'
    SORANGE=$'\033[38;5;208m'
    GREEN=$'\033[1;32m'
    SGREEN=$'\033[32m'
    RESET=$'\033[0m'
fi

prox_os=""
if command -v pveversion >/dev/null 2>&1; then
   ver=$(pveversion | head -n1 | cut -d'/' -f2 | cut -d'-' -f1)
   prox_os="Proxmox VE ${ver:+ $ver}"
fi

# level color
_distro_id=$(grep '^ID=' /etc/os-release 2>/dev/null | cut -d'=' -f2 | tr -d '"')
_distro_base=$(grep '^ID_LIKE=' /etc/os-release 2>/dev/null | cut -d'=' -f2 | tr -d '"')

if [ -n "$prox_os" ]; then
    label_color="$ORANGE"
else
    case "$_distro_id" in
        arch|endeavouros|manjaro|garuda)
            label_color="$BLUE" ;;
        ubuntu)
            label_color="$ORANGE" ;;
        linuxmint)
            label_color="$GREEN" ;;
        pop)
            label_color="$TEAL" ;;
        cachyos)
            label_color="$TEAL" ;;
        void)
            label_color="$GREEN" ;;
        nixos)
            label_color="$BLUE" ;;
        *)
            case "$_distro_base" in
                *arch*)             label_color="$BLUE" ;;
                *ubuntu*|*debian*)  label_color="$ORANGE" ;;
                *)                  label_color="$PURPLE" ;;
            esac
            ;;
    esac
fi

# apply custom label color if --color was used
[ -n "$_CUSTOM_LABEL_COLOR" ] && label_color="$_CUSTOM_LABEL_COLOR"

# sysinfo
if [ -n "$prox_os" ]; then
    os="$prox_os"
else
    os_name=$(grep '^NAME=' /etc/os-release 2>/dev/null | cut -d'"' -f2 || echo 'Linux')
    os_version=$(grep '^VERSION=' /etc/os-release 2>/dev/null | cut -d'"' -f2 || echo '')
    os="$os_name${os_version:+ $os_version}"
fi
kernel="$(uname -r)"
device="$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || echo 'Unknown')"
uptime_p=$(uptime -p 2>/dev/null)
if [[ "$uptime_p" == up* ]]; then
    uptime="${uptime_p#up }"
else
    uptime=$(uptime 2>/dev/null | sed 's/.*up \([^,]*\).*/\1/' | xargs || echo "unknown")
fi
terminal="${TERM}"
res_output=$(xrandr --query 2>/dev/null)
display_res=$(echo "$res_output" | grep " primary" | grep -oE '[0-9]+x[0-9]+' | head -n1)
[ -z "$display_res" ] && display_res="unknown"
display_res2=$(echo "$res_output" | grep " connected" | grep -v " primary" | grep -oE '[0-9]+x[0-9]+' | head -n1)
cpu_info="$(lscpu | grep "Model name:" | cut -d':' -f2 | xargs) @ $(lscpu | grep "CPU MHz:" | lscpu | awk -F: '/CPU MHz/ {printf "%.1f GHz", $2/1000}' || echo "unknown")"
if command -v lspci >/dev/null 2>&1; then
    gpu_raw=$(lspci 2>/dev/null | grep -i 'vga\|3d\|display' | head -n1)
    gpu_info=$(echo "$gpu_raw" \
        | sed 's/.*: //' \
        | sed 's/ (rev [0-9a-f]*)$//' \
        | sed 's/Corporation //' \
        | sed 's/Technologies //' \
        | sed 's/ \[/\n/' \
        | tail -n1 \
        | sed 's/\]//')
    [ -z "$gpu_info" ] && gpu_info="unknown"
else
    gpu_info="unknown"
fi

ram_used=$(free -h | awk '/^Mem:/ {print $3}')
ram_total=$(free -h | awk '/^Mem:/ {print $2}')
ram="$ram_used / $ram_total"

# lines — info values wrapped in _INFO_COLOR so --color tints them too
lines=()
lines+=("${label_color}OS:${RESET} ${_INFO_COLOR}$os${RESET}")
lines+=("${label_color}Kernel:${RESET} ${_INFO_COLOR}Linux $kernel${RESET}")
lines+=("${label_color}Device:${RESET} ${_INFO_COLOR}$device${RESET}")
lines+=("${label_color}Uptime:${RESET} ${_INFO_COLOR}$uptime${RESET}")
lines+=("${label_color}Terminal:${RESET} ${_INFO_COLOR}$terminal${RESET}")
lines+=("${label_color}Display-res:${RESET} ${_INFO_COLOR}$display_res${RESET}")
[ -n "$display_res2" ] && lines+=("${label_color}Display-res2:${RESET} ${_INFO_COLOR}$display_res2${RESET}")
lines+=("${label_color}CPU-info:${RESET} ${_INFO_COLOR}$cpu_info${RESET}")
lines+=("${label_color}GPU-info:${RESET} ${_INFO_COLOR}$gpu_info${RESET}")
lines+=("${label_color}Ram:${RESET} ${_INFO_COLOR}$ram${RESET}")

# border
max_len=0
for line in "${lines[@]}"; do
    clean=$(echo -e "$line" | sed 's/\x1b\[[0-9;]*m//g')
    len=${#clean}
    (( len > max_len )) && max_len=$len
done

box_content_width=$max_len
box_inner_width=$((box_content_width + 2))
border=$(printf '─%.0s' $(seq 1 $box_inner_width))

distro_id=$(cat /etc/os-release 2>/dev/null | grep '^ID=' | cut -d'=' -f2 | tr -d '"')
distro_base=$(cat /etc/os-release 2>/dev/null | grep '^ID_LIKE=' | cut -d'=' -f2 | tr -d '"')

# ascii
if [ -n "$prox_os" ]; then
    o="$ORANGE"
    w="$WHITE"
    r="$RESET"
    IFS= read -r -d '' ascii <<EOF
             ${w}@@@@${r}   ${w}@@@@${r}
          ${o}++++${r} ${w}@@@@@@@${r} ${o}++++${r}
            ${o}++++${r} ${w}@@@${r} ${o}++++${r}
              ${o}++++ ++++${r}
             ${o}++++${r}${w}@@@${r}${o}++++${r}
           ${o}++++${r} ${w}@@@@@${r} ${o}++++${r}
          ${o}+++${r} ${w}@@@@${r} ${w}@@@@${r} ${o}+++${r}
             ${w}@@@${r}     ${w}@@@${r}

EOF
else
    distro_id=$(grep '^ID=' /etc/os-release 2>/dev/null | cut -d'=' -f2 | tr -d '"')
    distro_base=$(grep '^ID_LIKE=' /etc/os-release 2>/dev/null | cut -d'=' -f2 | tr -d '"')

    case "$distro_id" in
        arch|endeavouros|manjaro|garuda)
            b="$SBLUE"
            r="$RESET"
            IFS= read -r -d '' ascii <<EOF
                   ${b}-'${r}
                  ${b}.o+'${r}
                 ${b}'ooo/${r}
                ${b}'+oooo:${r}
               ${b}'+oooooo:${r}
               ${b}-+oooooo+:${r}
             ${b}'/:-:++oooo+:${r}
            ${b}'/++++/+++++++:${r}
           ${b}'/++++++++++++++:${r}
          ${b}'/+++ooooooooooooo/'${r}
         ${b}./ooosssso++osssssso+'${r}
        ${b}.oossssso-''''/ossssss+'${r}
       ${b}-osssssso.      :ssssssso.${r}
      ${b}:osssssss/        osssso+++.${r}
     ${b}/ossssssss/        +ssssooo/-${r}
   ${b}'/ossssso+/:-        -:/+osssso+-${r}
  ${b}'+sso+:-'                 '.-/+oso:${r}
 ${b}'++:.                           '-/+/${r}
 ${b}.'                                 '${r}
EOF
        ;;
    ubuntu)
        or="$SORANGE"
        r="$RESET"
        IFS= read -r -d '' ascii <<EOF

              ${or}===========${r}
          ${or}===================${r}
        ${or}=======================${r}
      ${or}=================     =====${r}
     ${or}==========       =     ======${r}
    ${or}========= -=        ===========${r}
   ${or}========    .=======.    ========${r}
  ${or}========    ===========    ========${r}
  ${or}====   =   =============   :=======${r}
  ${or}===     =  ========================${r}
  ${or}====   =   =============   :=======${r}
  ${or}========    ===========    ========${r}
