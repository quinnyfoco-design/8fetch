               ${b}'+oooooo:${r}
               ${b}-+oooooo+:${r}
             ${b}'/:-:++oooo+:${r}
            ${b}'/++++/+++++++:${r}
           ${b}'/++++++++++++++:${r}
          ${b}'/+++ooooooooooooo/'${r}
         ${b}./ooosssso++osssssso+'${r}
        ${b}.oossssso-''''/ossssss+'${r}
       ${b}-osssssso.      :ssssssso.${r}
      ${b}:osssssss/        osssso+++.${r}
     ${b}/ossssssss/        +ssssooo/-${r}
   ${b}'/ossssso+/:-        -:/+osssso+-${r}
  ${b}'+sso+:-'                 '.-/+oso:${r}
 ${b}'++:.                           '-/+/${r}
