    ${sg}=====${r}...${sg}===${r}...............${sg}=====${r}
   ${sg}======${r}...${sg}===${r}...${sg}===${r}...${sg}===${r}...${sg}======${r}
   ${sg}======${r}...${sg}===${r}...${sg}===${r}...${sg}===${r}...${sg}======${r}
   ${sg}======${r}...${sg}===${r}...${sg}===${r}...${sg}===${r}...${sg}======${r}
   ${sg}======${r}...${sg}===${r}...${sg}===${r}...${sg}===${r}...${sg}======${r}
   ${sg}======${r}...${sg}===${r}...${sg}===${r}...${sg}===${r}...${sg}======${r}
    ${sg}=====${r}...${sg}===============${r}...${sg}=====${r}
     ${sg}=====${r}...................${sg}=====${r}
      ${sg}======${r}...............${sg}======${r}
       ${sg}=========================${r}
         ${sg}=====================${r}
            ${sg}===============${r}


EOF
        ;;
    pop)
        sb="$SBRIGHTBLUE"
        r="$RESET"
        IFS= read -r -d '' ascii <<EOF

            ${sb}.++++++++++++*..${r}
         ${sb}.++++++++++++++*****.${r}
       ${sb}.+++${r}.........${sb}++*********.${r}
      ${sb}+++${r}.....${sb}+-${r}.....${sb}+***********${r}
     ${sb}++++${r}.....${sb}+++${r}.....${sb}************${r}
    ${sb}++++++${r}.....${sb}+**${r}....${sb}***${r}....${sb}******${r}
   ${sb}.+++++++${r}.....${sb}*=${r}...${sb}+**${r}.....${sb}******.${r}
   ${sb}+++++++++${r}........${sb}****${r}....${sb}********${r}
   ${sb}++++++++**${r}.....${sb}******${r}...${sb}*********${r}
   ${sb}++++++*****${r}....${sb}******${r}..${sb}**********${r}
   ${sb}.+++********${r}....${sb}****************.${r}
    ${sb}+***********${r}....${sb}***${r}..${sb}**********${r}
     ${sb}*****************************${r}
      ${sb}*****${r}.................${sb}*****${r}
       ${sb}.***${r}.................${sb}***.${r}
         ${sb}.*******************.${r}
           ${sb}..*************..${r}



EOF
        ;;
    cachyos)
        t="$TEAL"
        d="$TEAL_DIM"
        r="$RESET"
        IFS= read -r -d '' ascii <<EOF

        ${t}**${d}++++++++++++++++${t}*${r}
       ${d}=++++${t}*${d}+++++++++++++${r}      ${d}=${r}
      ${d}==+++==++${t}*${d}+++++++++${r}      ${d}=--${r}
     ${d}===++++====++++++++${r}        ${d}=${r}
    ${d}====+++++++++++++++${r}
   ${d}=====++++${r}                ${d}+++${r}
  ${d}===+++${t}*${d}++${r}                ${d}=====${r}
 ${t}+++++++${t}*${d}+${r}                  ${d}---${r}
${d}========${t}*${r}
 ${d}===++++++${r}                        ${d}++++${r}
  ${d}+${t}*${d}+++++++${r}                      ${d}======${r}
   ${d}+++${t}***${d}+++=                     ${d}----${r}
     ${d}+++++===+++=================${r}
      ${d}++++==+++++${t}*${d}+============${r}
       ${d}+++=+++++++++++========${r}
        ${d}+++++++++++++++++====${r}
         ${d}+++++++++++++++++++${r}
EOF
        ;;
    void)
        IFS= read -r -d '' ascii <<'EOF'
                -------
              -----------
               -----------
            *   --   ------
            **         ----
           ****    -    ----
         @@****@@*++=-@@#+++@@
         @@@**@@@%+@@=@@@@+#@@
          @@%%@@@=-@@#@@@%-#@@
          @@#* @@*%@+@@@@%#@@@
           **** @*=--*@@%++=
           ****    -    ----
            ****         --
            ******    *   -
             ***********
              ***********
                *******

EOF
        ;;
    nixos)
        b="$BLUE"
        w="$WHITE"
        r="$RESET"
        IFS= read -r -d '' ascii <<EOF
         ${b}+++${r}     ${w}-----   ---${r}         
         ${b}+++*${r}     ${w}----- ----${r}         
          ${b}++**${r}     ${w}--------${r}          
     ${b}+++++++********${r}${w}---===${r}     ${b}+${r}     
    ${b}++++++++*********${r}${w}-====${r}    ${b}+++${r}    
          ${w}=====${r}       ${w}=====${r}  ${b}+++++${r}   
         ${w}====${r}           ${w}====${r}${b}++++${r}     
 ${w}--=-=======${r}             ${w}==${r}${b}**+++++++${r} 
${w}-------====${r}               ${b}******+++++${r}
 ${w}--------=${r}${b}**${r}             ${b}**********+${r} 
     ${w}----${r}${b}****${r}           ${b}****${r}         
    ${w}----${r}  ${b}*****${r}       ${b}*****${r}          
    ${w}---${r}    ${b}****+${r}${w}=========${w}--------${r}    
     ${w}-${r}     ${b}*****+${r}${w}=======${w}--------${r}     
          ${b}**++++++${r}     ${w}=---${r}          
         ${b}++++ +++++${r}     ${w}----${r}         
         ${b}+++   +++++${r}     ${w}---${r}         

EOF
        ;;
    *)
        case "$distro_base" in
                    arch|endeavouros|manjaro|garuda)
            b="$SBLUE"
            r="$RESET"
            IFS= read -r -d '' ascii <<EOF
                   ${b}-'${r}
                  ${b}.o+'${r}
                 ${b}'ooo/${r}
                ${b}'+oooo:${r}
               ${b}'+oooooo:${r}
               ${b}-+oooooo+:${r}
             ${b}'/:-:++oooo+:${r}
            ${b}'/++++/+++++++:${r}
           ${b}'/++++++++++++++:${r}
          ${b}'/+++ooooooooooooo/'${r}
         ${b}./ooosssso++osssssso+'${r}
        ${b}.oossssso-''''/ossssss+'${r}
       ${b}-osssssso.      :ssssssso.${r}
      ${b}:osssssss/        osssso+++.${r}
     ${b}/ossssssss/        +ssssooo/-${r}
   ${b}'/ossssso+/:-        -:/+osssso+-${r}
  ${b}'+sso+:-'                 '.-/+oso:${r}
 ${b}'++:.                           '-/+/${r}
 ${b}.'                                 '${r}
EOF
        ;;  
            *ubuntu*|*debian*)
            or="$SORANGE"
            r="$RESET"
            IFS= read -r -d '' ascii <<EOF

              ${or}===========${r}
          ${or}===================${r}
        ${or}=======================${r}
      ${or}=================     =====${r}
     ${or}==========       =     ======${r}
    ${or}========= -=        ===========${r}
   ${or}========    .=======.    ========${r}
  ${or}========    ===========    ========${r}
  ${or}====   =   =============   :=======${r}
  ${or}====   =   =============   :=======${r}
  ${or}====   =   =============   :=======${r}
  ${or}========    ===========    ========${r}
   ${or}========    .=======:    ========${r}
    ${or}========= -=        ===========${r}
     ${or}==========       =     ======${r}
      ${or}=================     =====${r}
        ${or}=======================${r}
          ${or}===================${r}
              ${or}===========${r}


EOF
                ;;
            *)
                y="$SYELLOW"
                b="$SBLACK"
                r="$RESET"
                IFS= read -r -d '' ascii <<EOF
              ${b}a8888b.${r}
             ${b}d888888b.${r}
             ${b}8P${r}"${b}YP${r}"${b}Y88${r}
             8|o||o|88${r}
             8'    .88${r}
             8'._.' Y8.${r}
            d/      '8b.${r}
          .dP   .     Y8b.${r}
         d8:'   "   '::88b.${r}
        d8"           'Y88b${r}
       :8P     '       :888${r}
        8a.    :      _a88P${r}
      ._/"Yaa_ :    .| 88P|${r}
      \    YP"      '| 8P  '.${r}
      /     \._____.d|    .'${r}
      '--..__)888888P'._.'${r}
EOF
                ;;
        esac
        ;;
esac
fi

mapfile -t ascii_arr <<< "$ascii"
# printing
box_height=$((${#lines[@]} + 2))

for (( i=0; i < ${#ascii_arr[@]}; i++ )); do
    left="${ascii_arr[i]}"

    right=""
    if (( i < box_height )); then
        if (( i == 0 )); then
            right="${_INFO_COLOR}╭${border}╮${RESET}"
        elif (( i == box_height - 1 )); then
            right="${_INFO_COLOR}╰${border}╯${RESET}"
        else
            idx=$((i - 1))
            content="${lines[idx]}"
            clean_content=$(echo -e "$content" | sed 's/\x1b\[[0-9;]*m//g')
            content_len=${#clean_content}
            total_padding=$((box_content_width - content_len))
            right="${_INFO_COLOR}│${RESET} "
            right+="${content}"
            for (( p=0; p<total_padding; p++ )); do
                right+=" "
            done
            right+=" ${_INFO_COLOR}│${RESET}"
        fi
    fi

    clean_left=$(printf "%s" "$left" | sed 's/\x1b\[[0-9;]*m//g')
    visible_len=${#clean_left}
    pad=$(( 40 - visible_len ))
    (( pad < 0 )) && pad=0
    printf "%s%${pad}s%s\n" "$left" "" "$right"
done
echo ""
